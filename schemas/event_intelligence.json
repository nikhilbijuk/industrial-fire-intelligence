{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EventIntelligence",
  "description": "Standardized evidence and classification output for an investigated thermal event",
  "type": "object",
  "required": [
    "event_id",
    "spatio_temporal",
    "classification",
    "evidence_breakdown",
    "uncertainty",
    "priority"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "example": "EVT-2026-IND-0042"
    },
    "spatio_temporal": {
      "type": "object",
      "required": [
        "centroid",
        "first_detected",
        "last_detected",
        "observation_count",
        "active_days",
        "spatial_drift_meters",
        "mean_frp_mw",
        "max_frp_mw"
      ],
      "properties": {
        "centroid": {
          "type": "object",
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        "first_detected": { "type": "string", "format": "date-time" },
        "last_detected": { "type": "string", "format": "date-time" },
        "observation_count": { "type": "integer", "minimum": 1 },
        "active_days": { "type": "integer", "minimum": 1 },
        "spatial_drift_meters": { "type": "number", "minimum": 0 },
        "mean_frp_mw": { "type": "number", "minimum": 0 },
        "max_frp_mw": { "type": "number", "minimum": 0 },
        "night_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "landcover_class": { "type": "string", "example": "Built-up / Industrial" },
        "nearest_facility_name": { "type": "string", "example": "Panipat Refinery & Petrochemical Complex" },
        "facility_type": { "type": "string", "example": "oil_refinery" },
        "distance_to_facility_meters": { "type": "number", "minimum": 0 }
      }
    },
    "classification": {
      "type": "object",
      "required": ["domain", "subclass", "confidence"],
      "properties": {
        "domain": {
          "type": "string",
          "enum": ["INDUSTRIAL", "AGRICULTURAL", "WILDFIRE", "OTHER"]
        },
        "subclass": {
          "type": "string",
          "enum": [
            "PERSISTENT_OPERATIONAL_SOURCE",
            "ABNORMAL_INDUSTRIAL_FIRE",
            "CROP_RESIDUE_BURNING",
            "FOREST_CANOPY_FIRE",
            "TRANSIENT_ANOMALY"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "evidence_breakdown": {
      "type": "object",
      "required": ["supporting_evidence", "counter_evidence"],
      "properties": {
        "supporting_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["factor", "description", "weight"],
            "properties": {
              "factor": { "type": "string" },
              "description": { "type": "string" },
              "weight": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            }
          }
        },
        "counter_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["factor", "description", "weight"],
            "properties": {
              "factor": { "type": "string" },
              "description": { "type": "string" },
              "weight": { "type": "number", "minimum": -1.0, "maximum": 0.0 }
            }
          }
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "required": ["attribution_level", "cloud_obscuration_risk", "caveats"],
      "properties": {
        "attribution_level": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "cloud_obscuration_risk": { "type": "string", "enum": ["MINIMAL", "MODERATE", "SEVERE"] },
        "caveats": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "priority": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
    }
  }
}
